<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f1e"/>
      <stop offset="100%" stop-color="#1e1b4b"/>
    </linearGradient>
    <linearGradient id="pulseGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="50%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#22c55e"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- Background with subtle border -->
  <rect width="64" height="64" rx="14" fill="url(#bg)"/>
  <rect x="1" y="1" width="62" height="62" rx="13" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-opacity="0.4"/>
  
  <!-- Subtle Grid lines -->
  <line x1="12" y1="32" x2="52" y2="32" stroke="#312e81" stroke-width="0.75" stroke-dasharray="2,2"/>
  <line x1="32" y1="12" x2="32" y2="52" stroke="#312e81" stroke-width="0.75" stroke-dasharray="2,2"/>
  
  <!-- Pulse Line (Monitoring wave) -->
  <path d="M 10 32 L 22 32 L 26 22 L 32 44 L 38 18 L 43 35 L 47 32 L 54 32" 
        fill="none" 
        stroke="url(#pulseGrad)" 
        stroke-width="3" 
        stroke-linecap="round" 
        stroke-linejoin="round"
        filter="url(#glow)"/>
        
  <!-- Glowing Live Dot -->
  <circle cx="47" cy="32" r="3.5" fill="#22c55e" filter="url(#glow)"/>
</svg>
