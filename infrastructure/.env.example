# ============================================================
# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
# НЕ коммить .env в git!
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=monitoring

# --- Backend ---

# Окружение. Оставь "production" на сервере. Для локальной разработки: development
ENVIRONMENT=production

# Обязательно: секретный ключ JWT.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_КЛЮЧ_64_СИМВОЛА

# Обязательно: ключ шифрования паролей SSH/WinRM в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=ЗАМЕНИ_НА_FERNET_КЛЮЧ

# Обязательно: API-ключ для инgest-эндпоинтов (/api/metrics, /api/probe, /api/logs).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_КЛЮЧ

# CORS: список разрешённых источников через запятую (адрес твоего фронтенда).
# Пример: https://monitoring.example.com
ALLOWED_ORIGINS=http://localhost:3000

# URL бэкенда как его ВИДИТ БРАУЗЕР пользователя (не Docker-сеть!).
# Если деплой на VPS с IP 1.2.3.4: http://1.2.3.4:8000
# Если с доменом и nginx: https://api.monitoring.example.com
# Для локального запуска: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Первый администратор (создаётся автоматически при первом запуске).
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# --- Agent ---
# ID сервера, на котором запущен агент (должен совпадать с ID в системе).
AGENT_SERVER_ID=srv-1

# --- Prober ---
# URL сайта для проверки.
PROBER_TARGET_URL=https://example.com
